# HTTP
# Built locally by `docker compose up -d --build` (compose.yaml has pull_policy: build). Never a registry image.
FAUCET_IMAGE=ckbolt/cwbtc-faucet:local
PORT=3008
# Host port, published on 127.0.0.1 only. 3008 is free on the CKBolt VPS (in use: 3000 5432 6300 8228 8787 9735 18787).
FAUCET_PORT=3008
HOST=0.0.0.0
# Public URL values. On the CKBolt VPS: https://ckbolt-faucet.texlabs.org (the Cloudflare Tunnel hostname).
PUBLIC_BASE_URL=http://localhost:3008
CORS_ORIGIN=http://localhost:3008
# 1 = trust the last X-Forwarded-For entry, which Cloudflare sets to the visitor. Keep the port on 127.0.0.1.
TRUST_PROXY_HOPS=1

# CKB testnet
CKB_RPC_URL=https://testnet.ckbapp.dev/

# Created automatically by ./scripts/init.sh. Do not use the issuer key.
FAUCET_PRIVATE_KEY_SECRET_FILE=./secrets/faucet_private_key
IP_HASH_SALT_SECRET_FILE=./secrets/ip_hash_salt
ADMIN_TOKEN_SECRET_FILE=./secrets/admin_token
TURNSTILE_SECRET_KEY_SECRET_FILE=./secrets/turnstile_secret_key

# cWBTC claim amount in raw units (8 decimals, 1 raw unit = 1 sat). 1000000 = 0.01 cWBTC, enough for many
# 1,000-20,000 sat CKBolt swaps. The upstream public faucet gives 10000000000 (100 cWBTC).
CLAIM_AMOUNT_RAW=1000000
# CKB put into each recipient cWBTC cell; the recipient receives it with the cWBTC. This is what a claim costs the
# faucet in CKB (plus a tiny fee). Minimum 146 (occupied size of a cWBTC cell, see src/ckb/capacity.ts); 147 = +1 margin.
UDT_CELL_CAPACITY_CKB=147
# Anti-sybil limits for the CKBolt demo. The global cap bounds the daily CKB spend: 50 x 147 = 7,350 CKB per day.
ADDRESS_COOLDOWN_SECONDS=86400
IP_COOLDOWN_SECONDS=1800
ADDRESS_DAILY_CLAIM_LIMIT=1
IP_DAILY_CLAIM_LIMIT=3
GLOBAL_DAILY_CLAIM_LIMIT=50

# SQLite state
DATABASE_PATH=./data/faucet.sqlite

# Worker behavior
WORKER_ENABLED=true
WORKER_POLL_MS=3000
# 15 minutes: CKB testnet blocks can take several minutes to include a transaction when the pool is busy (seen 2026-11-07).
TX_CONFIRM_TIMEOUT_MS=900000
TX_CONFIRM_POLL_MS=3000

# Optional Cloudflare Turnstile. If REQUIRE_TURNSTILE=false, the faucet still runs without it.
# To enable: put the secret key in secrets/turnstile_secret_key, set the site key here, then REQUIRE_TURNSTILE=true.
REQUIRE_TURNSTILE=false
TURNSTILE_SITE_KEY=
